draw 0,0 "Why did you open a BRICK!?"
js:window.alert("Wha- WHO'S THERE? YOU! YES YOU! HOBO LOOKIN' HUMAN! WHO TOLD YOU IT WAS OKAY TO OPEN BRICKS? YOU'LL PAY FOR THIS!");
js:(function(){window.brickCount=window.brickCount||0;window.bossSpawned=false;function spawn(n){for(let i=0;i<n;i++){let w=document.createElement("div"),h=document.createElement("div"),x=document.createElement("span");w.style.cssText="position:absolute;left:"+(50+Math.random()*300)+"px;top:"+(50+Math.random()*200)+"px;width:140px;height:90px;background:#330000;border:2px solid red;color:red;font-family:monospace;z-index:9999;overflow:hidden";h.style.cssText="background:#550000;padding:3px;cursor:move;user-select:none;font-size:12px";h.textContent="BRICK";x.textContent="×";x.style.cssText="float:right;cursor:pointer;margin-left:6px";h.append(x);w.append(h);document.body.appendChild(w);let vx=(Math.random()<0.5?-1:1)*(1+Math.random()*1.5),vy=(Math.random()<0.5?-1:1)*(1+Math.random()*1.5),ox,oy,drag=false;h.onmousedown=e=>{drag=true;ox=e.clientX-w.offsetLeft;oy=e.clientY-w.offsetTop};document.onmouseup=()=>drag=false;document.onmousemove=e=>{if(drag){w.style.left=e.clientX-ox+"px";w.style.top=e.clientY-oy+"px"}};x.onclick=()=>{w.remove();window.brickCount++;if(window.brickCount===10)window.alert("TEN BRICKS!? YOU GOT SOME NERVE, PAL! KEEP CLICKIN' AND SEE WHAT HAPPENS!");if(window.brickCount===25)window.alert("TWENTY-FIVE!? WHAT ARE YOU, SOME KINDA BRICK-DESTROYIN' MANIAC!?");if(window.brickCount>=50&&!window.bossSpawned){window.bossSpawned=true;spawnBoss()}spawn(6)};function tick(){if(!drag){let L=w.offsetLeft,T=w.offsetTop;L+=vx;T+=vy;let W=window.innerWidth-150,H=window.innerHeight-100;if(L<0||L>W)vx*=-1;if(T<0||T>H)vy*=-1;w.style.left=L+"px";w.style.top=T+"px"}requestAnimationFrame(tick)}tick()}}function spawnBoss(){let w=document.createElement("div"),h=document.createElement("div"),x=document.createElement("span"),body=document.createElement("div"),hpText=document.createElement("div"),dialog=document.createElement("div");w.style.cssText="position:absolute;left:200px;top:150px;width:260px;height:200px;background:gold;border:4px solid #ffcc00;color:black;font-family:monospace;z-index:10000;overflow:hidden;box-shadow:0 0 20px gold";h.style.cssText="background:#ccaa00;padding:5px;cursor:move;user-select:none;font-size:16px;font-weight:bold";h.textContent="GOLDEN BRICK BOSS";x.textContent="×";x.style.cssText="float:right;cursor:pointer;margin-left:10px;font-size:18px";h.append(x);body.style.cssText="padding:8px;font-size:14px";hpText.style.cssText="font-weight:bold;margin-bottom:6px";dialog.style.cssText="font-style:italic;color:#442200";body.append(hpText,dialog);w.append(h,body);document.body.appendChild(w);let hp=10,vx=3,vy=3,ox,oy,drag=false;function update(){hpText.textContent="HP: "+hp;dialog.textContent=hp>7?"YOU THINK YOU CAN BREAK *ME*?":hp>4?"HEY! WATCH IT, PAL!":"OKAY OKAY STOP CLICKIN'!!!"}update();h.onmousedown=e=>{drag=true;ox=e.clientX-w.offsetLeft;oy=e.clientY-w.offsetTop};document.onmouseup=()=>drag=false;document.onmousemove=e=>{if(drag){w.style.left=e.clientX-ox+"px";w.style.top=e.clientY-oy+"px"}};x.onclick=()=>{hp--;w.style.boxShadow="0 0 20px red";setTimeout(()=>w.style.boxShadow="0 0 20px gold",200);update();if(hp<=0){w.remove();document.querySelectorAll("div").forEach(e=>{if(e.textContent.includes("BRICK"))e.remove()});window.alert("YOU… YOU ACTUALLY BEAT THE GOLDEN BRICK… I… I GOT NOTHING LEFT TO SAY TO YOU.");var crh = ""; for(var i = 0; i < 9000000; i++) { crh = crh + i.toString(); console.log(crh) }}};function tick(){if(!drag){let L=w.offsetLeft,T=w.offsetTop;L+=vx;T+=vy;let W=window.innerWidth-280,H=window.innerHeight-220;if(L<0||L>W)vx*=-1;if(T<0||T>H)vy*=-1;w.style.left=L+"px";w.style.top=T+"px"}requestAnimationFrame(tick)}tick()}spawn(6)})();
